# RPM package from the build MyGo leaves in
# build/linux-<arch>/. MyGo makes the .deb, .tar.gz and PKGBUILD itself; nfpm
# adds the .rpm. Run by .github/workflows/release.yml:
#   export ARCH=amd64 RPM_ARCH=x86_64 VERSION=0.4.0
#   sed -e "s/\${ARCH}/$ARCH/g" -e "s/\${RPM_ARCH}/$RPM_ARCH/g" -e "s/\${VERSION}/$VERSION/g" packaging/nfpm.yaml.tmpl > build/nfpm.yaml
#   nfpm package -p rpm -f build/nfpm.yaml -t build/
name: tako
arch: ${RPM_ARCH}
platform: linux
version: ${VERSION}
section: utils
maintainer: zdva <tako@example.invalid>
description: "Octopus terminal, every one of your SSH servers in view."
homepage: https://github.com/zdva/tako
license: GPL-3.0-or-later
contents:
  - src: build/linux-${ARCH}/tako
    dst: /opt/tako/tako
    file_info: { mode: 0755 }
  - src: build/linux-${ARCH}/libghostty-vt.so
    dst: /opt/tako/libghostty-vt.so
    file_info: { mode: 0755 }
  - src: build/linux-${ARCH}/icon.png
    dst: /opt/tako/icon.png
  - src: LICENSE
    dst: /usr/share/licenses/tako/LICENSE
  - src: /opt/tako/tako
    dst: /usr/bin/tako
    type: symlink
  - src: build/linux-${ARCH}/tako.desktop
    dst: /usr/share/applications/tako.desktop
  - src: build/linux-${ARCH}/tako-256x256.png
    dst: /usr/share/icons/hicolor/256x256/apps/tako.png
  - src: build/linux-${ARCH}/tako-512x512.png
    dst: /usr/share/icons/hicolor/512x512/apps/tako.png
overrides:
  rpm:
    depends:
      - gtk3
